# Build outputs
*.apk
*.apkm
*.apks
*.xapk
*.idsig
*.mpe
*.mpp

# Local tooling (Morphe CLI is downloaded locally)
tools/

# Local handsets / bases / outputs (never committed; keep the root clean)
local/

# Stale top-level merge dir (pipeline uses build/merged/)
merged/

# Python venv / worktrees / agent state
.venv/
.worktrees/
.superpowers/

# Local signing material
*.keystore
*.jks

# Gradle / build
.gradle/
build/
**/build/
.kotlin/
local.properties
# Generated version stamp (recreated by generateUnhookedVersion every build)
extensions/extension/src/main/java/com/feurstagram/extension/UnhookedVersion.java

# IDE (share run configurations, ignore the rest)
.idea/*
!.idea/runConfigurations/

# OS
.DS_Store

# Dexloom fingerprint research (local only)
.dexloom-ws
dexloom-*.jar

# Local pipeline secrets (see .env.example)
.env

# Python test caches
__pycache__/
*.py[cod]
