# Unhooked pipeline secrets — copy to `.env` (never committed).
# Plain KEY=VALUE lines; '#' starts a comment; values may be quoted.
# Real environment variables override anything set here.
#
# GitHub Packages credentials (Morphe registry) do NOT live here:
# keep those in ~/.gradle/gradle.properties as gpr.user/gpr.key.

# UNHOOKED_KEYSTORE=unhooked.keystore
# UNHOOKED_KEY_ALIAS=unhooked
# UNHOOKED_KEYSTORE_PASS=
# UNHOOKED_KEY_PASS=
# UNHOOKED_OUTPUT_PATH=unhooked.apk

# Base Instagram APK/bundle to patch. Lets you run ./gradlew buildApk
# with no -Papk flag (-Papk still wins when both are set).
# INPUT_APK=base-454.apkm
# (fetch it with: glab packages download --name unhooked-base
#  --version 454.0.0.13.77 --filename base-454.apkm)
